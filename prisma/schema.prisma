datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  SERVICE
  PHYSICAL
  DIGITAL
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CASH
  OTHER
}

enum PaymentStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum EmailDeliveryStatus {
  SENT
  FAILED
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  currency    String   @default("USD")
  timezone    String   @default("UTC")
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  customers     Customer[]
  products      Product[]
  plans         Plan[]
  quotations    Quotation[]
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
  taxRules      TaxRule[]
  discountRules DiscountRule[]
  auditLogs     AuditLog[]
  emailLogs     EmailLog[]
  billingJobs   BillingJob[]

  @@index([slug])
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  passwordHash         String
  name                 String
  role                 UserRole   @default(STAFF)
  status               UserStatus @default(ACTIVE)
  emailVerified        DateTime?
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // If role is CUSTOMER, link to specific Customer record
  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([email])
  @@index([organizationId])
  @@index([role])
}

model Customer {
  id              String         @id @default(cuid())
  organizationId  String
  customerNumber  String
  name            String
  email           String
  phone           String?
  companyName     String?
  billingAddress  String?
  shippingAddress String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  status          CustomerStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?
  quotations    Quotation[]
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]

  @@unique([organizationId, customerNumber])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  notes          String?
  productType    ProductType   @default(SERVICE)
  salesPrice     Decimal       @db.Decimal(12, 2)
  costPrice      Decimal       @default(0.00) @db.Decimal(12, 2)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  planProducts      PlanProduct[]
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
  discountRules     DiscountRule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String // e.g., "Odoo Brand", "Enterprise Edition"
  sku             String?
  priceAdjustment Decimal  @default(0.00) @db.Decimal(12, 2) // e.g., +560.00
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]

  @@index([productId])
}

model Plan {
  id                     String          @id @default(cuid())
  organizationId         String
  name                   String
  code                   String
  description            String?
  price                  Decimal         @db.Decimal(12, 2)
  billingInterval        BillingInterval @default(MONTHLY)
  minimumQuantity        Int             @default(1)
  startDate              DateTime?
  endDate                DateTime?
  autoClose              Boolean         @default(false)
  allowPause             Boolean         @default(true)
  allowEarlyCancellation Boolean         @default(true)
  status                 PlanStatus      @default(ACTIVE)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planProducts  PlanProduct[]
  subscriptions Subscription[]
  quotations    Quotation[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

model PlanProduct {
  id        String   @id @default(cuid())
  planId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([planId, productId])
  @@index([planId])
  @@index([productId])
}

model Quotation {
  id              String          @id @default(cuid())
  organizationId  String
  quotationNumber String
  customerId      String
  planId          String?
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime
  subtotal        Decimal         @default(0.00) @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0.00) @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  notes           String?
  terms           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan         Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  lines        QuotationLine[]
  subscription Subscription?

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
}

model QuotationLine {
  id           String   @id @default(cuid())
  quotationId  String
  productId    String
  variantId    String?
  description  String?
  quantity     Int      @default(1)
  unitPrice    Decimal  @db.Decimal(12, 2)
  discountRate Decimal  @default(0.00) @db.Decimal(5, 2)
  taxRate      Decimal  @default(0.00) @db.Decimal(5, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  quotation Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([productId])
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  subscriptionNumber String
  customerId         String
  planId             String
  quotationId        String?            @unique
  status             SubscriptionStatus @default(CONFIRMED)
  billingFrequency   BillingInterval    @default(MONTHLY)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  nextBillingDate    DateTime
  lastBilledDate     DateTime?
  paymentTerms       String             @default("Immediate")
  subtotal           Decimal            @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal            @default(0.00) @db.Decimal(12, 2)
  taxAmount          Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal            @default(0.00) @db.Decimal(12, 2)
  autoRenew          Boolean            @default(true)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan         Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotation    Quotation?            @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  lines        SubscriptionLine[]
  invoices     Invoice[]
  history      SubscriptionHistory[]

  @@unique([organizationId, subscriptionNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String   @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String?
  description    String?
  quantity       Int      @default(1)
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountRate   Decimal  @default(0.00) @db.Decimal(5, 2)
  taxRate        Decimal  @default(0.00) @db.Decimal(5, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([productId])
}

model SubscriptionHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  action         String // CREATED, CONFIRMED, ACTIVATED, PAUSED, RESUMED, RENEWED, CANCELLED, BILLED
  previousStatus String?
  newStatus      String?
  reason         String?
  actorEmail     String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model Invoice {
  id                 String        @id @default(cuid())
  organizationId     String
  invoiceNumber      String
  customerId         String
  subscriptionId     String?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  idempotencyKey     String?       @unique
  status             InvoiceStatus @default(CONFIRMED)
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  subtotal           Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal       @default(0.00) @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0.00) @db.Decimal(12, 2)
  notes              String?
  terms              String?
  pdfUrl             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id           String   @id @default(cuid())
  invoiceId    String
  productId    String
  variantId    String?
  description  String?
  quantity     Int      @default(1)
  unitPrice    Decimal  @db.Decimal(12, 2)
  discountRate Decimal  @default(0.00) @db.Decimal(5, 2)
  taxRate      Decimal  @default(0.00) @db.Decimal(5, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id                   String        @id @default(cuid())
  organizationId       String
  paymentNumber        String
  invoiceId            String
  customerId           String
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @default(BANK_TRANSFER)
  paymentDate          DateTime      @default(now())
  transactionReference String?
  status               PaymentStatus @default(COMPLETED)
  notes                String?
  createdAt            DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([invoiceId])
  @@index([customerId])
}

model TaxRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String // e.g. "GST 18%", "Standard VAT 20%"
  rate           Decimal  @db.Decimal(5, 2) // e.g. 18.00
  isInclusive    Boolean  @default(false)
  isDefault      Boolean  @default(false)
  status         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model DiscountRule {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           DiscountType @default(PERCENTAGE)
  value          Decimal      @db.Decimal(12, 2) // e.g. 10.00 for 10% or $10
  minSpend       Decimal?     @db.Decimal(12, 2)
  minQuantity    Int?
  startDate      DateTime?
  endDate        DateTime?
  usageLimit     Int?
  usedCount      Int          @default(0)
  productId      String?
  status         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([code])
}

model BillingJob {
  id                     String    @id @default(cuid())
  organizationId         String
  jobType                String    @default("RECURRING_BILLING")
  status                 JobStatus @default(PENDING)
  subscriptionsProcessed Int       @default(0)
  invoicesGenerated      Int       @default(0)
  errorMessage           String?
  executionTimeMs        Int?
  createdAt              DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // e.g. "CREATE_PRODUCT", "CANCEL_SUBSCRIPTION"
  entity         String // e.g. "Subscription", "Invoice"
  entityId       String?
  details        String? // JSON string
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model EmailLog {
  id             String              @id @default(cuid())
  organizationId String
  recipientEmail String
  subject        String
  templateName   String
  resendId       String?
  status         EmailDeliveryStatus @default(SENT)
  errorMessage   String?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}
